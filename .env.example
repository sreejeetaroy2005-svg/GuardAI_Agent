# ==========================================================
# AgentGuard Environment Configuration
# ==========================================================

# Maximum loan amount allowed for automated approval (INR)
MAX_AUTO_APPROVE_AMOUNT=10000.0

# Minimum confidence score threshold required for automated approval [0.0 - 1.0]
MIN_CONFIDENCE_THRESHOLD=0.80

# Slack Incoming Webhook URL for incident and policy violation alerts
# If unset or empty, AgentGuard will log alerts locally without crashing
SLACK_WEBHOOK_URL=

# Global Kill Switch: if true, all automated approvals are immediately blocked
KILL_SWITCH_ACTIVE=false

# Threshold of repeated failures by an agent before triggering a HIGH severity incident
REPEATED_FAILURE_THRESHOLD=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Optional: OpenAI API Key for real LLM integration (leave blank to use MockModelClient)
OPENAI_API_KEY=

# Optional: OpenAI Base URL (default https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI Model Name (default gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini
